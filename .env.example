# ═══════════════════════════════════════════════════════════════════════
#  COPY TO .env AND FILL IN.  .env IS GIT-IGNORED — NEVER COMMIT SECRETS.
#  In production prefer Docker secrets (/run/secrets/*) over a .env file.
#  Every value below is a PLACEHOLDER. None of these are real credentials.
# ═══════════════════════════════════════════════════════════════════════

APP_ENV=development                 # development | staging | production
APP_NAME=hotel-price-monitor
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ─── Database ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hotelmonitor
POSTGRES_USER=hotelmonitor_app
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_string

# ─── Redis (broker + locks + rate limits) ────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_BROKER=0
REDIS_DB_RESULT=1
REDIS_DB_CACHE=2

# ─── Security ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is the KEK that wraps per-credential data keys. Losing it means
# losing every stored source credential. Back it up separately from the DB.
CREDENTIAL_KEK=CHANGE_ME_generate_with_Fernet_generate_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_MAX_AGE_SECONDS=43200

# First admin, created by scripts/create_admin.py. Change the password on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_before_first_run

# ─── Monitoring defaults ─────────────────────────────────────────────
DEFAULT_INTERVAL_MINUTES=30
# Both floors at 0 = report EVERY confirmed price move, however small.
# Chosen deliberately: with a 50-rupee AND 2% rule, a real 32.50 drop (2.8%)
# cleared the percentage but not the rupee floor and nobody was told, and
# because the baseline only resets on a threshold-clearing move, the next
# comparison started from a price the hotel had already stopped charging.
# The blip protection is CONFIRM_CHECKS below, not these floors: a move still
# has to survive two consecutive checks before anyone hears about it, so
# dynamic-pricing flicker that reverts within 30 minutes stays quiet.
DEFAULT_MIN_DELTA_ABS=0
DEFAULT_MIN_DELTA_PCT=0
DEFAULT_CONFIRM_CHECKS=2
DEFAULT_CURRENCY=INR
DISPATCH_JITTER_SECONDS=180

# Which price is shown and compared: "exclusive" is the headline rate the
# booking page prints (₹999 for a room quoted "₹999 + ₹49.95 taxes & fees"),
# "inclusive" is the all-in total (₹1,048.95). Sites that publish only one
# figure are unaffected either way. Changing this re-baselines every series on
# its next check — one silent check, no false "price dropped" alerts.
PRICE_BASIS=exclusive

# ─── Sold-out rollover ───────────────────────────────────────────────
# A last-minute window that comes back "no available rooms" is re-checked one
# night later, and the rate found there is recorded against THAT night -- the
# sold-out for the night you asked about is still recorded, the roll only adds
# a reading. 1 = tonight and tomorrow roll, nothing further out. 0 = off.
SOLD_OUT_ROLLOVER_DAYS=1

# ─── Playwright ──────────────────────────────────────────────────────
BROWSER_HEADLESS=true
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata
BROWSER_NAV_TIMEOUT_MS=45000
BROWSER_MAX_CONCURRENCY=3
BROWSER_USER_AGENT_SUFFIX=HotelPriceMonitor/1.0 (+https://example.com/bot-info)
ARTIFACT_DIR=/data/artifacts
ARTIFACT_RETENTION_DAYS=7

# ─── Self-repair ─────────────────────────────────────────────────────
# When a fetch shows a source's stored selectors have stopped describing the
# page -- a collapsed room list, or schema drift -- discovery is re-run against
# it and a VERIFIED result is written back. Set ENABLED=false to keep the
# alerting and do the repair by hand.
# Each attempt drives a real browser against the site, so the budget is small:
# a source that has defeated discovery MAX_ATTEMPTS times is left to a person
# rather than retried forever.
AUTO_REDISCOVERY_ENABLED=true
AUTO_REDISCOVERY_COOLDOWN_MINUTES=360
AUTO_REDISCOVERY_MAX_ATTEMPTS=3

# ─── Politeness / access control ─────────────────────────────────────
RESPECT_ROBOTS_TXT=true
DEFAULT_RATE_LIMIT_PER_MIN=6
EGRESS_ALLOWED_DOMAINS=

# ─── Email notifications ─────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=alerts@example.com
EMAIL_FROM_NAME=Hotel Price Monitor
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
RESEND_API_KEY=

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=price_change_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── Notification throttling ─────────────────────────────────────────
DIGEST_WINDOW_SECONDS=60
RECIPIENT_MAX_MSGS_PER_HOUR=10
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# ─── Observability ───────────────────────────────────────────────────
SENTRY_DSN=
METRICS_ENABLED=true

# Dead-man's switch. Beat pings this every 5 minutes; the service at the other
# end alerts when the pings STOP.
#
# Every other alarm here is raised by this system about itself, so none of them
# can fire when this system is what died -- a stopped beat cannot report that
# it stopped. This is the only check that works from outside. Create a free
# check at healthchecks.io (or Cronitor / Better Uptime) and paste its ping URL.
# Empty disables it.
HEARTBEAT_URL=
HEARTBEAT_TIMEOUT_SECONDS=10
